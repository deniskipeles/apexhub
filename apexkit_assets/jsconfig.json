{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/custom/*": [
        "./modules/custom/*"
      ],
      "@/esm/*": [
        "./modules/esm/*"
      ],
      "https://esm.sh/hono": [
        "./.apexkit/types/https___esm.sh_hono/index.d.ts"
      ],
      "https://esm.sh/hono/*": [
        "./.apexkit/types/https___esm.sh_hono/index.d.ts/*"
      ],
      "https://esm.sh/hono/jsx": [
        "./.apexkit/types/https___esm.sh_hono_jsx/index.d.ts"
      ],
      "https://esm.sh/hono/jsx/*": [
        "./.apexkit/types/https___esm.sh_hono_jsx/index.d.ts/*"
      ]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "**/*.js",
    "**/*.ts",
    "**/*.jsx",
    "**/*.tsx",
    "**/*.html",
    "apexkit.d.ts",
    ".apexkit/types/**/*.d.ts"
  ]
}